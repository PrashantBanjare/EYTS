generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
//  USER — students, employees and admins share this table.
//  Student-specific fields are optional so an employee record can
//  exist without them. authController.signup still requires them
//  for STUDENT registrations, so students cannot skip them.
// ═══════════════════════════════════════════════════════════════
model User {
  id              String        @id @default(uuid())
  name            String
  fatherName      String?
  motherName      String?
  qualification   String?
  institutionName String?
  passingYear     String?
  occupation      String?       // "student" | "working"
  occupationField String?
  aadharNumber    String?       @unique
  address         String?
  gender          String?
  age             Int?
  email           String        @unique
  whatsappNumber  String
  password        String
  role            Role          @default(STUDENT)
  resetOtp        String?
  resetOtpExpiry  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // ── employee identity ──
  employeeCode    String?       @unique   // human-facing ID, e.g. "EMP001"
  referralCode    String?       @unique   // share code, e.g. "PRAS01"
  isActive        Boolean       @default(true)
  photoUrl        String?

  // ── employee task window (set by the office) ──
  taskStartAt     DateTime?
  taskDeadline    DateTime?
  taskTarget      Int?                    // null = use the global target

  // ── proctoring, per student ──
  // null = follow the exam's global setting. Set only when the office
  // needs to treat one candidate differently from everyone else.
  proctoringOverride ProctoringMode?
  consentWaived      Boolean       @default(false)

  // ── who recruited this student ──
  referredById    String?
  referredBy      User?         @relation("Referral", fields: [referredById], references: [id])
  referrals       User[]        @relation("Referral")

  // ── employee payout / KYC details ──
  panNumber             String?
  bankAccountName       String?
  bankAccountNumber     String?
  bankIfsc              String?
  upiId                 String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // ── relations ──
  payments        Payment[]
  attempts        ExamAttempt[]
  result          Result[]
  commissions     Commission[]  @relation("EmployeeCommissions")
  payouts         Payout[]
  notifications   Notification[]
  parentalConsent ParentalConsent?

  @@index([referredById])
  @@index([role])
}

enum Role {
  STUDENT
  EMPLOYEE
  ADMIN
}

// ═══════════════════════════════════════════════════════════════
//  PROCTORING LEVELS
//  OFF            nothing is watched
//  BROWSER_ONLY   tab switches, fullscreen exits, copy/paste — no camera
//  FACE_DETECTION camera on, flags only, no images kept
//  FULL_RECORDING camera on, periodic snapshots stored
// ═══════════════════════════════════════════════════════════════
enum ProctoringMode {
  OFF
  BROWSER_ONLY
  FACE_DETECTION
  FULL_RECORDING
}

model Exam {
  id                  String        @id @default(uuid())
  title               String
  description         String?
  durationSeconds     Int           @default(3600)
  totalMarks          Int           @default(50)
  isEnabled           Boolean       @default(false)
  allowReattempt      Boolean       @default(false)
  resultReleaseAt     DateTime?
  answerKeyReleaseAt  DateTime?     // null = key hidden even after results
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // ── proctoring, exam-wide default ──
  // requireParentalConsent applies only to candidates under 18. Leaving it
  // on is the safe default under the DPDP Act; turning it off is a
  // deliberate decision the office has to make.
  proctoringMode         ProctoringMode @default(OFF)
  requireParentalConsent Boolean        @default(true)

  sections            Section[]
  attempts            ExamAttempt[]
}

model Section {
  id        String     @id @default(uuid())
  name      String
  examId    String
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  exam      Exam       @relation(fields: [examId], references: [id])
  questions Question[]
}

model Question {
  id          String           @id @default(uuid())
  text        String
  sectionId   String
  order       Int              @default(0)
  explanation String?
  createdAt   DateTime         @default(now())

  section     Section          @relation(fields: [sectionId], references: [id])
  options     QuestionOption[]
  answers     AttemptAnswer[]
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  key        String   // "A" | "B" | "C" | "D"
  text       String
  isCorrect  Boolean  @default(false)

  question   Question @relation(fields: [questionId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  userId        String
  amount        Float
  currency      String        @default("INR")
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  gateway       String?
  couponCode    String?
  discount      Int           @default(0)
  isFreeAccess  Boolean       @default(false)
  razorpayOrderId String?
  createdAt     DateTime      @default(now())

  user          User          @relation(fields: [userId], references: [id])
  commission    Commission?
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model ExamAttempt {
  id          String          @id @default(uuid())
  userId      String
  examId      String
  startedAt   DateTime        @default(now())
  submittedAt DateTime?
  timeTaken   Int?            // seconds
  isSubmitted Boolean         @default(false)

  // Which mode was actually in force for this sitting. Recorded on the
  // attempt so a later change to the exam settings cannot rewrite what
  // a candidate was told at the time.
  proctoringMode ProctoringMode @default(OFF)

  user        User            @relation(fields: [userId], references: [id])
  exam        Exam            @relation(fields: [examId], references: [id])
  answers     AttemptAnswer[]
  result      Result?

  proctoringEvents    ProctoringEvent[]
  proctoringSnapshots ProctoringSnapshot[]
}

model AttemptAnswer {
  id          String      @id @default(uuid())
  attemptId   String
  questionId  String
  selectedKey String?     // "A" | "B" | "C" | "D" — null if skipped
  isCorrect   Boolean     @default(false)
  markedReview Boolean    @default(false)

  attempt     ExamAttempt @relation(fields: [attemptId], references: [id])
  question    Question    @relation(fields: [questionId], references: [id])
}

model Result {
  id            String      @id @default(uuid())
  userId        String
  attemptId     String      @unique
  totalScore    Int
  totalQuestions Int
  percentage    Float
  percentile    Float?
  rank          Int?
  timeTaken     Int
  sectionScores Json        // { sectionId: score }
  submittedAt   DateTime
  isPublished   Boolean     @default(false)

  user          User        @relation(fields: [userId], references: [id])
  attempt       ExamAttempt @relation(fields: [attemptId], references: [id])
}

model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique
  discount    Int      // in rupees
  isActive    Boolean  @default(true)
  usedCount   Int      @default(0)
  maxUses     Int?     // null = unlimited
  createdAt   DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
//  PARENTAL CONSENT
//  Required before a candidate under 18 can sit an exam with the
//  camera on. The parent verifies by OTP sent to their own email;
//  the student cannot self-approve.
//
//  ipAddress and verifiedAt exist so the consent can be evidenced
//  later if a parent ever disputes having given it.
// ═══════════════════════════════════════════════════════════════
model ParentalConsent {
  id           String    @id @default(uuid())
  studentId    String    @unique
  parentName   String
  parentEmail  String
  parentPhone  String
  relationship String?   // Father | Mother | Guardian
  otp          String?
  otpExpiry    DateTime?
  verified     Boolean   @default(false)
  verifiedAt   DateTime?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  student      User      @relation(fields: [studentId], references: [id])

  @@index([verified])
}

// ═══════════════════════════════════════════════════════════════
//  PROCTORING EVENTS
//  One row per incident. eventType is a free string rather than an
//  enum so a new detector can be added without a migration.
//
//    TAB_SWITCH, WINDOW_BLUR, FULLSCREEN_EXIT, COPY, PASTE,
//    RIGHT_CLICK, DEVTOOLS, FACE_ABSENT, MULTIPLE_FACES,
//    LOOKING_AWAY, CAMERA_BLOCKED, CAMERA_ERROR
// ═══════════════════════════════════════════════════════════════
model ProctoringEvent {
  id         String      @id @default(uuid())
  attemptId  String
  eventType  String
  severity   String      @default("LOW")   // LOW | MEDIUM | HIGH
  metadata   Json?
  occurredAt DateTime    @default(now())

  attempt    ExamAttempt @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
  @@index([eventType])
}

// ═══════════════════════════════════════════════════════════════
//  PROCTORING SNAPSHOTS
//  Only written in FULL_RECORDING mode. imageData holds a base64
//  JPEG; move this to object storage before any real volume, a
//  database is the wrong place for images at scale.
// ═══════════════════════════════════════════════════════════════
model ProctoringSnapshot {
  id         String      @id @default(uuid())
  attemptId  String
  imageData  String      @db.Text
  capturedAt DateTime    @default(now())
  flagged    Boolean     @default(false)
  flagReason String?

  attempt    ExamAttempt @relation(fields: [attemptId], references: [id])

  @@index([attemptId])
  @@index([flagged])
}

// ═══════════════════════════════════════════════════════════════
//  EMPLOYEE EARNINGS
//  ₹30 per paid enrollment + ₹5,000 per completed task of 1,000.
//  Paid out weekly (Monday–Sunday).
// ═══════════════════════════════════════════════════════════════

enum CommissionType {
  ENROLLMENT    // ₹30 for one paid enrollment
  TASK_BONUS    // ₹5,000 for completing the task
  TASK_PENALTY  // negative amount — 20% deducted for missing the deadline
}

enum CommissionStatus {
  PENDING      // earned, not yet transferred
  PAID         // included in a payout that has been transferred
  REVERSED     // student payment refunded — clawed back
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

model Commission {
  id          String            @id @default(uuid())

  employeeId  String
  employee    User              @relation("EmployeeCommissions", fields: [employeeId], references: [id])

  studentId   String?                            // null for TASK_BONUS rows

  // One commission per payment, enforced by the database so a retried
  // Razorpay verify can never credit the same enrollment twice.
  paymentId   String?           @unique
  payment     Payment?          @relation(fields: [paymentId], references: [id])

  type        CommissionType
  amount      Int                                // rupees
  status      CommissionStatus  @default(PENDING)

  payoutId    String?
  payout      Payout?           @relation(fields: [payoutId], references: [id])

  note        String?
  earnedAt    DateTime          @default(now())

  @@index([employeeId, status])
  @@index([earnedAt])
}

model Payout {
  id               String        @id @default(uuid())

  employeeId       String
  employee         User          @relation(fields: [employeeId], references: [id])

  periodStart      DateTime
  periodEnd        DateTime

  enrollmentCount  Int           @default(0)   // qualifying enrollments in the period
  commissionAmount Int           @default(0)   // ₹30 × enrollmentCount
  bonusAmount      Int           @default(0)   // task salary falling in the period
  totalAmount      Int           @default(0)

  status           PayoutStatus  @default(PENDING)
  paidAt           DateTime?
  reference        String?                     // UTR / UPI transaction reference
  notes            String?

  commissions      Commission[]
  createdAt        DateTime      @default(now())

  @@unique([employeeId, periodStart, periodEnd])
  @@index([status])
}

model Notification {
  id         String   @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  title      String
  body       String
  type       String   // PAYOUT | ENROLLMENT | MILESTONE | ANNOUNCEMENT
  link       String?  // in-app path, e.g. "/employee?tab=earnings"
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, isRead])
}